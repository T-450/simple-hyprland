{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": false,
    "height": 32,
    "modules-left": ["custom/arch", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "battery", "backlight", "tray"],

    "hyprland/window": {
        "format": "{}",
        "max-length": 48,
        "separate-outputs": false
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate"
    },

    "custom/arch": {
        "format": "",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#eeeeee'><b>{}</b></span>",
                "weekdays": "<span color='#cccccc'><b>{}</b></span>",
                "today": "<span color='#6688ff'><b>{}</b></span>",
                "days": "<span color='#929292'>{}</span>"
            }
        }
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-",
        "min-length": 6
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " muted",
        "tooltip": false,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": ["", "", ""]
        }
    },

    "network": {
        "tooltip": true,
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 connected",
        "format-linked": "󰈀 {ifname}",
        "format-disconnected": "󰖪 offline",
        "tooltip-format": "<b>{essid}</b>\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "<b>{ifname}</b>\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected"
    }
}
