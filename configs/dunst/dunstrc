[global]
    follow = mouse
    indicate_hidden = yes

    offset = (10, 10)

    separator_height = 2

    padding = 8
    horizontal_padding = 8
    text_icon_padding = 0
    frame_width = 2

    frame_color = "#6688ff"
    separator_color = frame

    sort = yes
    idle_threshold = 120
    font = JetBrainsMono Nerd Font 11
    line_height = 0
    markup = full
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    stack_duplicates = true
    hide_duplicate_count = false

    show_indicators = yes

    min_icon_size = 0
    max_icon_size = 64

    dmenu = /usr/bin/fuzzel --dmenu --prompt dunst:
    browser = /usr/bin/firefox --new-tab

    title = Dunst
    class = Dunst

    corner_radius = 10
    timeout = 5

[urgency_low]
    background = "#222222"
    foreground = "#cccccc"

[urgency_normal]
    background = "#222222"
    foreground = "#cccccc"

[urgency_critical]
    background = "#222222"
    foreground = "#eeeeee"
    frame_color = "#ff8080"
